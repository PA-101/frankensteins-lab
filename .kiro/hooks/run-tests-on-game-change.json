{
  "hooks": [
    {
      "name": "run-tests-on-game-change",
      "description": "Run the unit and property tests whenever game.js is saved.",
      "trigger": {
        "type": "file_change",
        "pattern": "game.js"
      },
      "action": {
        "type": "command",
        "command": "node tests.js && node tests.property.js",
        "cwd": "${workspaceFolder}"
      },
      "showOutput": true
    }
  ]
}
